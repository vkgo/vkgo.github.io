{% assign education = site.data.cv | where: 'title', 'Education' | first %}
{% if education %}
  <div class="home-education">
    {% for item in education.contents %}
      <div class="home-education__item">
        <div class="home-education__heading">
          <strong>{{ item.institution }}</strong>
          {% if item.year -%}
            <span>{{ item.year }}</span>
          {%- endif %}
        </div>
        {% if item.title %}
          <div class="home-education__degree">{{ item.title }}</div>
        {% endif %}
        {% if item.description %}
          <div class="home-education__details">
            {% for detail in item.description %}
              {% if detail.contents %}
                <div>
                  <div class="home-education__label">{{ detail.title }}</div>
                  <ul class="home-education__topics">
                    {% for subitem in detail.contents %}
                      <li>{{ subitem | emojify }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <div>{{ detail }}</div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
