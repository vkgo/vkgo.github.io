{% assign education = site.data.cv | where: 'title', 'Education' | first %}
{% if education %}
  <div class="home-education">
    {% for item in education.contents %}
      <div class="home-education__item">
        {% if item.logo %}
          <img class="home-education__logo" src="{{ item.logo | relative_url }}" alt="" loading="lazy" width="44" height="44">
        {% endif %}
        <div class="home-education__body">
          <div class="home-education__heading">
            <strong>{{ item.institution }}</strong>
            {% if item.year -%}
              <span>{{ item.year }}</span>
            {%- endif %}
          </div>
          {% if item.title %}
            <div class="home-education__degree">{{ item.title }}</div>
          {% endif %}
          {% comment %} Research-area lists render as chips under the intro (home_research.liquid). {% endcomment %}
          {% for detail in item.description %}
            {% unless detail.contents %}
              <div class="home-education__note">{{ detail }}</div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
