---
layout: default
---
<div class="reference-home">
  <aside class="reference-home__sidebar">
    {% include home_profile.liquid %}
  </aside>

  <main class="reference-home__main">
    <section id="about-me" class="reference-home__intro" aria-label="About me">
      {{ content }}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="reference-home__section">
        <h2>
          <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
          <a href="{{ '/news/' | relative_url }}">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section id="selected-publications" class="reference-home__section reference-home__publications">
        <h2>
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.education %}
      <section id="education" class="reference-home__section">
        <h2>
          <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
          Education
        </h2>
        {% include home_education.liquid %}
      </section>
    {% endif %}
  </main>
</div>
